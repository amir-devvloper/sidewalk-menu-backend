NODE_ENV=production
PORT=5000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-npm-run-hash-password
JWT_SECRET=generate-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30m

# Comma-separated exact origins. No wildcard when credentials are enabled.
FRONTEND_ORIGINS=https://your-domain.example,https://admin.your-domain.example

# For cross-site frontend/backend deployments use None + Secure.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Aban Gateway
ABAN_API_BASE=https://api.abangateway.ir/api/v1
ABAN_API_TOKEN=replace-with-new-aban-token
ABAN_WEBHOOK_SECRET=replace-with-aban-webhook-secret
ABAN_CALLBACK_URL=https://sidewalk-menu-backend.onrender.com/api/orders/payment/webhook
ABAN_REQUEST_TIMEOUT_MS=12000
